# /etc/rubli-ops.env — copy, fill, chmod 600. Read by scripts/ops-lib.sh. Runbook: docs/OPS_LAUNCH.md.

# Where the nightly offsite copy goes: pull (owner's PC fetches it) | rclone (free cloud tier)
RUBLI_OFFSITE=pull

# rclone only: remote:path from `rclone config` (use a crypt remote over B2/Drive — the DB holds user emails)
RUBLI_RCLONE_REMOTE=
# copies kept on the remote (~2 GB each: B2 free 10 GB → 3, OneDrive free 5 GB → 2)
RUBLI_OFFSITE_KEEP=3

# ntfy.sh phone push. No account. Anyone who knows the topic can read it: make it long and random.
RUBLI_NTFY_TOPIC=

# healthchecks.io ping URLs (free account): backup job (daily) and uptime (every 5 min)
RUBLI_HC_BACKUP_URL=
RUBLI_HC_UPTIME_URL=
